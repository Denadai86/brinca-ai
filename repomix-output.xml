}

@layer utilities {
  /* 1. ANIMAÇÕES ORGÂNICAS (BLOBS) */
  /* Movimento mais fluido e menos previsível para as bolhas de fundo */
  .animate-blob {
    animation: blob 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  
  .animation-delay-4000 {
    animation-delay: 4s;
  }

  /* 2. ANIMAÇÃO DE GRADIENTE (Efeito "Mágico" nos Botões) */
  /* Faz o gradiente do botão 'dançar' suavemente no hover */
  .animate-gradient-x {
    background-size: 200% 200%;
    animation: gradient-x 5s ease infinite;
  }

